# Frontend Configuration
VITE_API_URL=/api/contact

# Backend Configuration (Serverless / Express)
PORT=5001
NODE_ENV=production
FRONTEND_URL=https://espejo-partners.online

# Transactional Email Provider (Resend API)
# Get your API Key at https://resend.com
RESEND_API_KEY=re_123456789_your_actual_resend_api_key

# Email Sending Settings
# Default before domain verification: onboarding@resend.dev
# After verifying espejo-partners.online: inquiries@espejo-partners.online
SENDER_EMAIL=inquiries@espejo-partners.online

# Hardcoded Recipient
RECIPIENT_EMAIL=abe@espejo-partners.online
